# Copy to .env and fill in values. Never commit .env.
# Names only — leave the secrets out of git.

# Supabase. The service role key is server-side only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Alias accepted anywhere SUPABASE_URL is read.
VITE_SUPABASE_URL=

# Direct Postgres, for applying migrations/manual/*.sql by hand.
SUPABASE_DB_POOLER_URL=

# ScrapeCreators. One credit per data call. The daily job probes the balance
# before it spends the day's calls.
SCRAPECREATORS_API_KEY=
# Optional. Defaults to US.
SCRAPECREATORS_REGION=

# Stripe. Do not change price IDs in code to match a new price; they are
# pinned in api/create-checkout-session.ts.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Public origin used for checkout return URLs. Defaults to the request host.
APP_URL=

# Daily call ceiling. Unset keeps 1,500 hot snapshots + 4,500 rotation.
# Example: 3000
DAILY_CALL_BUDGET=
SNAPSHOT_HOT_LIMIT=
SNAPSHOT_ROTATION_LIMIT=
# Legacy combined cap. 0 / unset means "use the two tiers".
SNAPSHOT_TRACKED_LIMIT=
# Products the video-discovery step searches. The workflow default is 150.
DISCOVER_LIMIT=

# Optional caps.
TRANSCRIPT_DAILY_CAP=
DISCOVER_MIN_VIDEOS=
DISCOVER_MIN_VIEWS=

# Local server. macOS AirPlay holds 5000; use 5099.
PORT=

# Set to 1 to skip the credit probe. Do not set this on the scheduled job.
SKIP_CREDIT_PREFLIGHT=
